{
  "enabled": false,
  "uri": "bolt://neo4j:7687",
  "database": "neo4j",
  "username": "neo4j",
  "password": "",
  "collections": {
    "public": {
      "entity_types": ["product", "feature", "team"],
      "relation_types": ["supports", "owned_by"],
      "aliases": {},
      "version": "1"
    }
  },
  "extractor": {
